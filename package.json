{
  "name": "neon-community-suite",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Sistema profissional de bots Discord com dashboard premium, PostgreSQL, Redis e arquitetura escalavel.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n BOT,DASH -c red,white \"npm run dev -w @neon/security-bot\" \"npm run dev -w @neon/dashboard\"",
    "build": "npm run build --workspaces",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc -b",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate dev --name init --schema packages/database/prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "db:studio": "prisma studio --schema packages/database/prisma/schema.prisma",
    "db:seed": "tsx packages/database/prisma/seed.ts",
    "commands:deploy": "tsx scripts/deploy-commands.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "prisma": "^6.1.0",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.70",
    "@prisma/client": "^6.1.0",
    "discord.js": "^14.17.3",
    "dotenv": "^16.4.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  }
}
